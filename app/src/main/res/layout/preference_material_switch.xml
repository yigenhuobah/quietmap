<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 设置行：左图标 + 标题/副标题两行 + 右侧 MaterialSwitch。
    高度按 M3 两行列表规范 72dp，左右内边距 16dp，图标 24dp。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="72dp"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@android:id/icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:tint="?attr/colorOnSurfaceVariant" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@android:id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyLarge" />

        <TextView
            android:id="@android:id/summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?android:attr/textColorSecondary" />
    </LinearLayout>

    <!-- clickable=false 会把开关踢出无障碍树（isImportantForAccessibility 只认
         actionable/listener 节点），TalkBack 就读不到开/关状态；显式 yes 强制保留
         该节点，MaterialSwitch(SwitchCompat→CompoundButton) 的节点信息自带
         checkable/checked，状态随 onBindViewHolder 的 setChecked 同步。 -->
    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/preference_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="yes" />

</LinearLayout>
